+// PERMANENT: only for too many wrong fingers. The reason also becomes the
+// prompt, so $FPRINTPROMPT keeps saying so until the next resume re-arms it.
+void CFingerprint::disable(const std::string& reason) {
+    m_sFailureReason = reason;
+    m_sPrompt        = reason;
+    g_pHyprlock->enqueueForceUpdateTimers();
+}
+
+// TRANSIENT: every other failure re-arms the sensor by itself.
+//
+// A verify that ran for a while before erroring is the elanmoc2 driver's
+// ~10s wait-for-finger timeout ("transfer timed out", reported to us as
+// verify-unknown-error), not a fault: restart it straight away and say
+// nothing. Anything else is a real outage: show the reason (with no
+// fingerprint icon, which reads as "not available") and retry on a backoff
+// that doubles up to 30s, so a sensor or daemon that fails instantly is not
+// hammered. The first successful VerifyStart replaces the reason with the
+// ready prompt.
+void CFingerprint::recover(const std::string& reason, bool dropDevice) {
+    m_sDBUSState.verifying = false;
+
+    if (dropDevice && m_sDBUSState.device) {
+        // Release first: a claim left behind would make our own next Claim
+        // fail with "already claimed".
+        releaseDevice();
+        m_sDBUSState.device.reset();
+    }
+
+    if (m_bRestartPending)
+        return;
+
+    int delayMs;
+    if (m_bVerifyActive && std::chrono::steady_clock::now() - m_verifyStartedAt >= std::chrono::seconds(5)) {
+        Log::logger->log(Log::INFO, "fprint: verify timed out waiting for a finger, re-arming");
+        delayMs      = 250;
+        m_iBackoffMs = 1000;
+    } else {
+        Log::logger->log(Log::WARN, "fprint: {}, retrying in {}ms", reason, m_iBackoffMs);
+        delayMs          = m_iBackoffMs;
+        m_iBackoffMs     = std::min(m_iBackoffMs * 2, 30000);
+        m_sFailureReason = reason;
+        m_sPrompt        = reason;
+        g_pHyprlock->enqueueForceUpdateTimers();
+    }
+    m_bVerifyActive   = false;
+    m_bRestartPending = true;
+
+    g_pHyprlock->addTimer(
+        std::chrono::milliseconds(delayMs),
+        [](ASP<CTimer> self, void* data) {
+            const auto FP          = (CFingerprint*)data;
+            FP->m_bRestartPending = false;
+            if (!FP->m_sDBUSState.sleeping && !FP->m_sDBUSState.verifying)
+                FP->startVerify();
+        },
+        this);
 }
 
